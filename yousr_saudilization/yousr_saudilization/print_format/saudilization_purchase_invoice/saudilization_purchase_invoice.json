 "css": "body {\r\n    transform: scale(1.0);\r\n}\r\n\r\ntable { overflow: visible !important; }\r\nthead { display: table-header-group; }\r\ntr { page-break-inside: avoid; }\r\n\r\n\r\n.seller_table {\r\n    width: 100%;\r\n    table-layout: auto;\r\n    word-break: break-word;\r\n    page-break-inside: auto;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.seller_table,\r\n.seller_table th,\r\n.seller_table td {\r\n    font-size: 12px;\r\n    line-height: 1.0;\r\n    color: black !important;\r\n}\r\n\r\n\r\n.color_black {\r\n    color: black !important;\r\n}\r\n\r\n.bold {\r\n    font-weight: bold;\r\n}\r\n\r\n\r\n.print-format td,\r\n.print-format th {\r\n    padding: 5px 3px !important;\r\n    font-family: Noto Naskh Arabic;\r\n}\r\n",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Purchase Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% if letter_head and not no_letterhead -%}\r\n    {% if print_settings.repeat_header_footer %}\r\n        <div id=\"header-html\" class=\"hidden-pdf\" style=\"border-bottom: 1px solid black;\">\r\n            <div class=\"letter-head\">\r\n                {{ letter_head }}\r\n            </div>\r\n        </div>\r\n    {%- endif %}\r\n{%- endif %}\r\n\r\n{% if(doc.supplier) %}\r\n    {% set supplier = frappe.get_doc('Supplier', doc.supplier ) %}\r\n{% endif %}\r\n\r\n{% if(doc.supplier_address) %}\r\n    {% set supplier_address_doc = frappe.get_doc('Address', doc.supplier_address ) %}\r\n{% endif %}\r\n\r\n<div class=\"row\">\r\n    <div class=\"col-md-12 col-sm-12\">\r\n        <table style=\"width: 100%\">\r\n            <tr>\r\n                <td class=\"bold text-center\" style=\"font-size: 20px;\">Purchase Invoice</td>\r\n            </tr>\r\n        </table>\r\n        <table style=\"width: 100%\">\r\n            <colgroup>\r\n                <col style=\"width: 60%;\">\r\n                <col style=\"width: 45%;\">\r\n            </colgroup>\r\n            <tbody>\r\n                <tr>\r\n                    <td class=\"bold\">Vendor Details</td>\r\n                    <td class=\"text-right\" style=\"font-size: 12px;\"><span class=\"bold\">Reference:</span> {{doc.bill_no or \"\"}}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>{{ doc.supplier }}</td>\r\n                    <td class=\"text-right\" style=\"font-size: 12px;\"><span class=\"bold\">Issue Date:</span> {{doc.posting_date}}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>\r\n                        {% if(supplier_address_doc) %}\r\n                           {{ supplier_address_doc.address_line1 or \"\" }}\r\n                        {% endif %}                        \r\n                    </td>\r\n                    <td class=\"text-right\" style=\"font-size: 12px;\"><span class=\"bold\">Due Amount:</span> {{ frappe.utils.fmt_money(doc.outstanding_amount, currency=doc.currency) }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td class=\"bold\">Tax Number</td>\r\n                    <td class=\"text-right\" style=\"font-size: 12px;\"></td>\r\n                </tr> \r\n                <tr>\r\n                    <td>{{ supplier.tax_id }}</td>\r\n                    <td class=\"text-right\" style=\"font-size: 12px;\"></td>\r\n                </tr> \r\n            </tbody>\r\n        </table>\r\n        <table class=\"seller_table mt-3\">\r\n            <thead>\r\n                <tr>\r\n                    <th class=\"color_black\" style=\"font-weight: bold;width: 5%;\">#</th>             \r\n                    <th class=\"color_black\" style=\"font-weight: bold;width: 40%;\">\r\n                        <span style=\"display: block;\">Item Description</span>\r\n                        <span>\u0627\u0644\u0628\u064a\u0627\u0646</span>\r\n                    </th>\r\n                    <th class=\"color_black\" style=\"font-weight: bold;width: 16%;\">\r\n                        <span style=\"display: block;\">Expense Category</span>\r\n                        <span>\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0645\u0635\u0631\u0648\u0641</span>\r\n                    </th>\r\n                    <th class=\"color_black\" style=\"font-weight: bold;width: 15%;\">\r\n                        <span style=\"display: block;\">Total Before VAT</span>\r\n                        <span>\u0627\u0644\u0627\u062c\u0645\u0627\u0644\u064a \u0642\u0628\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</span>\r\n                    </th>\r\n                    <th class=\"color_black\" style=\"font-weight: bold;width: 8%;\">\r\n                        <span style=\"display: block;\">VAT %</span>\r\n                        <span>\u0627\u0644\u0636\u0631\u064a\u0628\u0629   %</span>\r\n                    </th>\r\n                    <th class=\"color_black\" style=\"font-weight: bold;width: 8%;\">\r\n                        <span style=\"display: block;\">VAT Amount</span>\r\n                        <span>   \u0645\u0628\u0644\u063a \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</span>\r\n                    </th>\r\n                    <th class=\"color_black\" style=\"font-weight: bold;width: 16%;\">\r\n                        <span style=\"display: block;\">Total Amount</span>\r\n                        <span>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629 </span>\r\n                    </th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% set total = namespace(amount = 0) %}\r\n                {%- for item_row in doc.items -%}\r\n                    {% set total.amount = item_row.amount %}\r\n                    <tr>\r\n                        <td>{{loop.index}}</td>\r\n                        <td class=\"bold\">{{ item_row.description }}</td>\r\n                        <td class=\"\">{{ item_row.expense_account or \"\" }}</td>\r\n                        <td class=\"\">{{ frappe.utils.fmt_money(item_row.amount, currency=doc.currency) }}</td>\r\n                        <td class=\"\">\r\n                            {% for tax in doc.taxes %}\r\n                                {% set data_object = json.loads(tax.item_wise_tax_detail) %}\r\n                                {% set key = item_row.item_code or item_row.item_name %}\r\n                                {%- if(data_object[key][0])-%}\r\n                                    {{ frappe.format(data_object[key][0], {'fieldtype': 'Percent'}) }}\r\n                                {%- endif -%}\r\n                            {% endfor %}                                \r\n                        </td>\r\n                         <td>\r\n                           {% for tax in doc.taxes %}\r\n                                {% set data_object = json.loads(tax.item_wise_tax_detail) %}\r\n                                {% set key = item_row.item_code or item_row.item_name %}\r\n                                {%- if(data_object[key][0])-%}\r\n                                {{(item_row.amount*data_object[key][0])/100}}\r\n                                   \r\n                                {%- endif -%}\r\n                            {% endfor %} \r\n                        </td>\r\n        <td>{% for tax in doc.taxes %}\r\n                                {% set data_object = json.loads(tax.item_wise_tax_detail) %}\r\n                                {% set key = item_row.item_code or item_row.item_name %}\r\n                                {%- if(data_object[key][0])-%}\r\n                                {{(((item_row.amount*data_object[key][0])/100)+item_row.amount)}}\r\n                                   \r\n                                {%- endif -%}\r\n                            {% endfor %}</td>\r\n                    </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n        </table>     \r\n        <table class=\"seller_table mt-3\">\r\n            <colgroup>\r\n                <col style=\"width: 50%;\">\r\n                <col style=\"width: 30%;\">\r\n                <col style=\"width: 20%;\">\r\n            </colgroup>\r\n            <tbody>\r\n                <tr>\r\n                    <td></td>\r\n                    <td class=\"bold\" style=\"font-size: 14px;\">Total Before VAT:</td>\r\n                    <td class=\"bold text-right\" style=\"font-size: 14px;\">{{ frappe.utils.fmt_money(doc.total, currency=doc.currency) }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td></td>\r\n                    <td class=\"bold\" style=\"font-size: 14px;\">Total VAT:</td>\r\n                    <td class=\"bold text-right\" style=\"font-size: 14px;\">{{ frappe.utils.fmt_money(doc.total_taxes_and_charges, currency=doc.currency) }}</td>\r\n                </tr> \r\n                <tr>\r\n                    <td></td>\r\n                    <td class=\"bold\" style=\"font-size: 14px;\">Total:</td>\r\n                    <td class=\"bold text-right\" style=\"font-size: 14px;\">{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</td>\r\n                </tr> \r\n                {% set payment_entries = frappe.db.sql(\"\"\"\r\n                                                        SELECT per.parent as payment_entry, pe.mode_of_payment, pe.paid_from, pe.paid_to,pe.posting_date, per.allocated_amount\r\n                                                        FROM `tabPayment Entry Reference` per\r\n                                                        LEFT JOIN `tabPayment Entry` pe ON pe.name = per.parent\r\n                                                        WHERE per.reference_doctype = 'Sales Invoice' \r\n                                                        AND per.reference_name = %s\r\n                                                    \"\"\", (doc.name,), as_dict=True) %}\r\n                {% if payment_entries %}\r\n                \r\n                    <tr>\r\n                        <td></td>\r\n                        <td class=\"bold\" style=\"font-size: 14px;\">Paid using Paid Receipt</td>\r\n                        <td class=\"bold text-right\" style=\"font-size: 14px;\"></td>\r\n                    </tr>\r\n                    {% for pe in payment_entries %}\r\n                        <tr>\r\n                            <td></td>\r\n                            <td class=\"bold\" style=\"font-size: 14px;\">{{ pe.payment_entry }}</td>\r\n                            <td class=\"bold text-right\" style=\"font-size: 14px;\"></td>\r\n                        </tr>\r\n                    {% endfor %}\r\n                    {% for pe in payment_entries %}\r\n                        <tr>\r\n                            <td></td>\r\n                            <td class=\"bold\" style=\"font-size: 14px;\">{{ pe.posting_date }}</td>\r\n                            <td class=\"bold text-right\" style=\"font-size: 14px;\"> {{ \"{:,.2f}\".format(pe.allocated_amount or 0) }}</td>\r\n                        </tr>\r\n                    {% endfor %}\r\n                    {% for pe in payment_entries %}\r\n                        <tr>\r\n                            <td></td>\r\n                            <td class=\"bold\" style=\"font-size: 14px;\">{{ pe.paid_from }}</td>\r\n                            <td class=\"bold text-right\" style=\"font-size: 14px;\"></td>\r\n                        </tr>\r\n                    {% endfor %}\r\n                {% endif %}\r\n\r\n            </tbody>            \r\n        </table>\r\n        <table class=\"seller_table mt-3\">\r\n            <tbody>\r\n                <tr>\r\n                    <td style=\"border-bottom: 1px solid black;font-size: 15px;\">Terms and Notes</td>\r\n                </tr>\r\n                <tr>\r\n                    <td class=\"bold\" style=\"font-size: 13px;\">{{ doc.terms or \"\" }}</td>\r\n                </tr>                \r\n            </tbody>            \r\n        </table>\r\n    </div>\r\n</div>",
