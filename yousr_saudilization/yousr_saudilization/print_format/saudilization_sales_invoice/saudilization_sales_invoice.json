 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set company = frappe.get_doc(\"Company\", doc.company)%}\n\n{% if (doc.company_address) %}\n    {% set company_address_doc = frappe.get_doc('Address', doc.company_address) %}\n{% endif %}\n\n\n{% if(doc.customer) %}\n    {% set customer = frappe.get_doc('Customer', doc.customer ) %}\n{% endif %}\n\n{% if(doc.customer_address) %}\n    {% set customer_address_doc = frappe.get_doc('Address', doc.customer_address ) %}\n{% endif %}\n\n\n    {% if letter_head and not no_letterhead -%}\n        {% if print_settings.repeat_header_footer %}\n            <div id=\"header-html\" class=\"hidden-pdf\">\n                <div class=\"letter-head\">\n                    {{ letter_head }}\n                </div>\n                <hr style=\"border: 1px solid lightgrey; margin: 5px 0;\">\n            </div>\n        {%- endif %}\n    {%- endif %}\n\n<div class=\"row overall_border\">\n    <div class=\"col-md-12 col-sm-12\">\n        <p class=\"text-center title_p\">\n          {% if doc.is_return %}\n            Credit Note اشعار دائن\n          {% else %}\n            Tax Invoice فاتورة ضريبية\n          {% endif %}\n        </p>\n        <table class=\"qr_table mb-2\">\n            <tbody>\n                <tr>\n                    <td class=\"bold \" style=\"font-size: small;\">\n                        <span class=\"span_heigt\">Invoice reference number(IRN)</span> <br>\n                        <span class=\"span_heigt\">{{ doc.name }}</span> <br>\n                        <span class=\"span_heigt\">Issue Date: {{ doc.posting_date }}</span><br>\n                        <strong style=\"font-weight: bold;\">Due Date:</strong> {{ frappe.utils.formatdate(doc.due_date, \"yyyy-mm-dd\") }}<br>\n            \n                        {% if doc.is_return and doc.return_against %}\n                        <span class=\"span_heigt\">Reference Inv No: {{ doc.return_against }}</span><br>\n                        {% endif %}  \n                    </td>\n                    <td class=\"text-center\" style=\"width: 180px;\">\n                        {% set qr = yousr_invoice_qr(doc) %}\n{% if qr.src %}<img src=\"{{ qr.src }}\" style=\"width:140px;height:140px\">\n{% else %}<span style=\"font-size:10px;\">{{ _(qr.message) }}</span>{% endif %}\n                    </td>\n                                \n                    <td class=\"text-right bold\" style=\"font-size: small;\">\n                        <span class=\"span_heigt\">الرقم التسلسلي</span> <br>\n                        <span class=\"span_heigt\">{{ doc.name }}</span> <br>\n                        <span class=\"span_heigt\">تاريخ اصدار الفاتورة: {{ doc.posting_date }}</span><br>\n                        <span class=\"span_heigt\"><strong>تاريخ الاستحقاق:</strong> {{ frappe.utils.formatdate(doc.due_date, \"yyyy-mm-dd\") }}</span><br>\n                        {% if doc.custom_delivery_date %}\n                        <span class=\"span_heigt\">تاريخ التوصيل: \n                                {{ frappe.utils.formatdate(doc.custom_delivery_date, \"yyyy-mm-dd\") }}\n                        </span><br>\n                        {% endif %}    \n                        {% if doc.is_return and doc.return_against %}\n                            <span class=\"span_heigt\">{{ doc.return_against }} :رقم الفاتورة المرجعية</span><br>\n                        {% endif %}\n                    </td>\n                </tr>\n            </tbody>\n        </table> \n        \n<table class=\"seller_table mb-2\">\n            <colgroup>\n                <col style=\"width: 24%;\">\n                <col style=\"width: 24%;\">\n                <col style=\"width: 4%;\">\n                <col style=\"width: 24%;\">\n                <col style=\"width: 24%;\">\n            </colgroup>\n            <tbody>\n                <tr>\n                    <td colspan=\"3\">\n                        <span class=\"title_p mb-2\" style=\"display: block;\">Seller Identification</span>\n                        <span class=\"bold small_text\">Seller Name</span>\n                    </td>\n                    <td class=\"text-right\" colspan=\"2\">\n                        <span class=\"title_p mb-2\" style=\"display: block;\">هوية المورد</span>\n                        <span class=\"bold small_text\">اسم المورد</span>\n                    </td>\n                </tr>\n                <tr>\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.name or \"\"}}</td>\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.custom_company_name_in_arabic or company.company_name }}</td>\n                </tr>\n                <tr>\n                    <td colspan=\"3\">\n                        <span class=\"bold small_text\">VAT Registration Number</span>\n                    </td>\n                    <td class=\"text-right\" colspan=\"2\">\n                        <span class=\"bold small_text\">رقم تسجيل ضريبة القيمة المضافة</span>\n                    </td>\n                </tr>\n                <tr>\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.tax_id or \"\"}}</td>\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.tax_id or \"\"}}</td>\n                </tr>\n                \n                {% set seller_commercial_reg_no = company.custom_cr_number or \"\" %}\n{% if(seller_commercial_reg_no) %}\n                    <tr>\n                        <td>\n                            <span class=\"bold smaller_text\">Additional Seller ID Type</span>\n                        </td>\n                        <td class=\"text-right\">\n                            <span class=\"bold smaller_text\">نوع المعرفات الإضافية للمورد</span>\n                        </td>\n                        <td></td>\n                        <td>\n                            <span class=\"bold smaller_text\">Additional Seller ID Number</span>\n                        </td>\n                        <td class=\"text-right\">\n                            <span class=\"bold smaller_text\">رقم المعرفات الإضافية للمورد</span>\n                        </td>\n                    </tr>\n                     {% if(seller_commercial_reg_no) %}\n                    <tr>\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">Commercial Registration (CR)</td>\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">السجل التجاري</td>\n                        <td></td>\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ seller_commercial_reg_no or \"\"}}</td>\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ seller_commercial_reg_no or \"\"}}</td>\n                    </tr>\n                    {% endif %}\n                {% endif %}\n                {% if(company_address_doc) %}\n                    <tr>\n                        <td colspan=\"3\">\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">Address</span>\n                            <span class=\"bold small_text\">Street Name</span>\n                        </td>\n                        <td class=\"text-right\" colspan=\"2\">\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">لعنوان</span>\n                            <span class=\"bold small_text\">اسم الشارع</span>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                            {{ company_address_doc.address_line1}}\n                        </td>\n                        <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                            {{ company_address_doc.custom_address_line_1_in_arabic or \"\" }}\n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td>\n                            <span class=\"bold smaller_text\">City</span>\n                        </td>\n                        <td class=\"text-right\">\n                            <span class=\"bold smaller_text\">اسم المدينة</span>\n                        </td>\n                        <td></td>\n                        {% if(company_address_doc.custom_building_number) %}\n                            <td>\n                                <span class=\"bold smaller_text\">Building Number</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">رقم المبنى</span>\n                            </td>\n                        {% else %}\n                            <td>\n                                <span class=\"bold smaller_text\">Country Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">رمز الدولة</span>\n                            </td>\n                        {% endif %}\n                    </tr>\n                    <tr>\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 5px;\">\n                             {{ company_address_doc.city or \"\" }}\n                        </td>\n                        \n                        <td class=\"bold bg-gray text-right smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 5px;\">\n                            {{ company_address_doc.custom_city_in_arabic or \"\" }}\n                        </td>\n                        <td></td>\n                        {% if(company_address_doc.custom_building_number) %}\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ company_address_doc.custom_building_number or \"\"}}\n                            </td>\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ company_address_doc.custom_building_number or \"\"}}\n                            </td>\n                        {% else %}\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ company_address_doc.custom_country_code or \"\" }}\n                            </td>\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ company_address_doc.custom_country_code or \"\" }}\n                            </td>\n                        {% endif %}\n    \n                    </tr>\n                    <tr>\n                        {% if(company_address_doc.custom_area) %}\n                            <td>\n                                <span class=\"bold smaller_text\">District</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">اسم الحي</span>\n                            </td>\n                            <td></td>\n                        {% endif %}\n                        {% if(company_address_doc.custom_building_number) %}\n                            <td>\n                                <span class=\"bold smaller_text\">Country Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">رمز الدولة</span>\n                            </td>\n                        {% else %}\n                            <td>\n                                <span class=\"bold smaller_text\">Postal Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">الرمز البريدى</span>\n                            </td>\n                        {% endif %}\n                        {% if(not company_address_doc.custom_area and company_address_doc.custom_building_number) %}\n                            <td></td>\n                            <td>\n                                <span class=\"bold smaller_text\">Postal Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">الرمز البريدى</span>\n                            </td>\n                        {% endif %}\n                    </tr>\n                    <tr>\n                        {% if(company_address_doc.custom_area) %}\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ company_address_doc.custom_area or \"\" }}\n                            </td>\n                            \n                            <td class=\"bold bg-gray text-right smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                               {{ company_address_doc.custom_district_in_arabic or \"\" }}\n                            </td>\n                            <td></td>\n                        {% endif %}\n                        {% if(company_address_doc.custom_building_number) %}\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                             {% set country_doc = frappe.get_doc(\"Country\", company_address_doc.country) %}\n                                    {{ country_doc.code or \"\" }}\n                            </td>\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {% set country_doc = frappe.get_doc(\"Country\", company_address_doc.country) %}\n                                    {{ country_doc.code or \"\" }}\n                            </td>\n                        {% else %}\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                               {{ company_address_doc.pincode or \"\" }}\n                            </td>\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ company_address_doc.pincode or \"\" }}\n                            </td>\n                        {% endif %}\n                        {% if(not company_address_doc.custom_area and company_address_doc.custom_building_number) %}\n                            <td></td>\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                               {{ company_address_doc.pincode or \"\" }}\n                            </td>\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ company_address_doc.pincode or \"\" }}\n                            </td>\n                        {% endif %}\n                    </tr>\n                    {% if(company_address_doc.pincode and company_address_doc.custom_building_number and company_address_doc.custom_area) %}\n                    <tr>\n                        <td></td>\n                        <td></td>\n                        <td></td>\n                        <td>\n                            <span class=\"bold smaller_text\">Postal Code</span>\n                        </td>\n                        <td class=\"text-right\">\n                            <span class=\"bold smaller_text\">الرمز البريدى</span>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td></td>\n                        <td></td>\n                        <td></td>\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                            {{ company_address_doc.pincode or \"\" }}\n                        </td>\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                            {{ company_address_doc.pincode or \"\" }}\n                        </td>\n                    </tr>\n                    {% endif %}\n                {% endif %}\n            </tbody>\n        </table>\n        <table class=\"seller_table mb-2\">\n            <colgroup>\n                <col style=\"width: 24%;\">\n                <col style=\"width: 24%;\">\n                <col style=\"width: 4%;\">\n                <col style=\"width: 24%;\">\n                <col style=\"width: 24%;\">\n            </colgroup>\n            <tbody>\n                <tr>\n                    <td colspan=\"3\">\n                        <span class=\"title_p mb-2\" style=\"display: block;\">Buyer Identification</span>\n                        <span class=\"bold small_text\">Buyer Name</span>\n                    </td>\n                    <td class=\"text-right\" colspan=\"2\">\n                        <span class=\"title_p mb-2\" style=\"display: block;\">تحديد هوية العميل</span>\n                        <span class=\"bold small_text\">اسم العميل</span>\n                    </td>\n                </tr>\n                <tr>\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ customer.customer_name or \"\"}}</td>\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ customer.custom_customer_name_in_arabic or customer.customer_name }}</td>\n                </tr>\n                <tr>\n                    <td colspan=\"3\">\n                        <span class=\"bold small_text\">VAT Registration Number</span>\n                    </td>\n                    <td class=\"text-right\" colspan=\"2\">\n                        <span class=\"bold small_text\">رقم تسجيل ضريبة القيمة المضافة</span>\n                    </td>\n                </tr>\n                <tr>\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ customer.custom_vat_registration_number or \"\" }}</td>\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ customer.custom_vat_registration_number or \"\" }}</td>\n                </tr>\n                {% if(customer_address_doc) %}\n                    <tr>\n                        <td colspan=\"3\">\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">Buyer Address</span>\n                            <span class=\"bold small_text\">Street Name</span>\n                        </td>\n                        <td class=\"text-right\" colspan=\"2\">\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">عنوان العميل</span>\n                            <span class=\"bold small_text\">اسم الشارع</span>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                           {{ customer_address_doc.address_line1 }}\n                        </td>\n                        <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                            {{ customer_address_doc.custom_address_line_1_in_arabic or \"\" }}\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            <span class=\"bold smaller_text\">City</span>\n                        </td>\n                        <td class=\"text-right\">\n                            <span class=\"bold smaller_text\">اسم المدينة</span>\n                        </td>\n                        <td></td>\n                        {% if(customer_address_doc.custom_building_number) %}\n                            <td>\n                                <span class=\"bold smaller_text\">Building Number</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">رقم المبنى</span>\n                            </td>\n                        {% else %}\n                            <td>\n                                <span class=\"bold smaller_text\">Country Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">رمز الدولة</span>\n                            </td>\n                        {% endif %}\n                    </tr>\n                    <tr>\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                            {{ customer_address_doc.city or \"\" }}\n                        </td>\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                            {{ customer_address_doc.custom_city_in_arabic or \"\" }}\n                        </td>\n                        <td></td>\n                        {% if(customer_address_doc.custom_building_number) %}\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                               {{ customer_address_doc.custom_building_number or \"\"}}\n                            </td>\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                               {{ customer_address_doc.custom_building_number or \"\"}}\n                            </td>\n                        {% else %}\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                               {{ customer_address_doc.custom_country_code or \"\" }}\n                            </td>\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\n                                {{ customer_address_doc.custom_country_code or \"\" }}\n                            </td>\n                        {% endif %}\n                    </tr>\n                    <tr>\n                        {% if(customer_address_doc.custom_area) %}\n                            <td>\n                                <span class=\"bold smaller_text\">District</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">اسم الحي</span>\n                            </td>\n                            <td></td>\n                        {% endif %}\n                        {% if(customer_address_doc.custom_building_number) %}\n                            <td>\n                                <span class=\"bold smaller_text\">Country Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">رمز الدولة</span>\n                            </td>\n                        {% else %} \n                            <td>\n                              <span class=\"bold smaller_text\">Postal Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">الرمز البريدى</span>\n                            </td>\n                        {% endif %}\n                        {% if(not customer_address_doc.custom_area and customer_address_doc.custom_building_number) %}\n                            <td></td>\n                            <td>\n                                <span class=\"bold smaller_text\">Postal Code</span>\n                            </td>\n                            <td class=\"text-right\">\n                                <span class=\"bold smaller_text\">الرمز البريدى</span>\n                            </td>\n                        {% endif %}\n     