r\n                            <td></td>\r\n                        {% endif %}\r\n                        {% if(customer_address_doc.custom_building_number) %}\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">Country Code</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0631\u0645\u0632 \u0627\u0644\u062f\u0648\u0644\u0629</span>\r\n                            </td>\r\n                        {% else %} \r\n                            <td>\r\n                              <span class=\"bold smaller_text\">Postal Code</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0628\u0631\u064a\u062f\u0649</span>\r\n                            </td>\r\n                        {% endif %}\r\n                        {% if(not customer_address_doc.custom_area and customer_address_doc.custom_building_number) %}\r\n                            <td></td>\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">Postal Code</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0628\u0631\u064a\u062f\u0649</span>\r\n                            </td>\r\n                        {% endif %}\r\n                    </tr>\r\n                    <tr>\r\n                        {% if(customer_address_doc.custom_area) %}\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ customer_address_doc.custom_area or \"\"}}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                              {{ customer_address_doc.custom_district_in_arabic or \"\"}}\r\n                            </td>\r\n                            <td></td>\r\n                        {% endif %}\r\n                        {% if(customer_address_doc.custom_building_number) %}\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                               {{ customer_address_doc.custom_country_code or \"\" }}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ customer_address_doc.custom_country_code or \"\" }}\r\n                            </td>\r\n                         {% else %} \r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                               {{ customer_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ customer_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                        {% endif %}\r\n                        {% if(not customer_address_doc.custom_area and customer_address_doc.custom_building_number) %}\r\n                            <td></td>\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                               {{ customer_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ customer_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                        {% endif %}\r\n                    </tr>\r\n                    {% if(customer_address_doc.pincode and customer_address_doc.custom_building_number and customer_address_doc.custom_area) %}\r\n                    <tr>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td>\r\n                            <span class=\"bold smaller_text\">Postal Code</span>\r\n                        </td>\r\n                        <td class=\"text-right\">\r\n                            <span class=\"bold smaller_text\">\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0628\u0631\u064a\u062f\u0649</span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                            {{ customer_address_doc.pincode or \"\" }}\r\n                        </td>\r\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                            {{ customer_address_doc.pincode or \"\" }}\r\n                        </td>\r\n                    </tr>\r\n                    {% endif %}\r\n                {% endif %}\r\n            </tbody>\r\n        </table>\r\n        <table class=\"item_table mb-2\">\r\n            <thead>\r\n                <tr class=\"text-center\">\r\n                    <td class=\"bold bg-gray\" style=\"font-size: 12px;\">\r\n                        <span>\u0648\u0635\u0641 \u0627\u0644\u0633\u0644\u0639\u0629 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0629</span> <br>\r\n                        <span>Product or Service <br> Description</span>\r\n                    </td>\r\n                    <td class=\"bold bg-gray\" style=\"font-size: 12px;\">\r\n                        <span>\u0627\u0644\u0643\u0645\u064a\u0629</span> <br>\r\n                        <span>Quantity</span>\r\n                    </td>\r\n                    <td class=\"bold bg-gray\" style=\"font-size: 12px;\">\r\n                        <span>\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</span> <br>\r\n                        <span>Unit Price</span>\r\n                    </td>\r\n                    <td class=\"bold bg-gray\" style=\"font-size: 12px;\">\r\n                        <span>\u0645\u0639\u062f\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629<br>\u0627\u0644\u0645\u0636\u0627\u0641\u0629</span><br>\r\n                        <span>VAT Rate</span>\r\n                    </td>\r\n                    <td class=\"bold bg-gray\" style=\"font-size: 12px;\">\r\n                        <span>\u0645\u0628\u0644\u063a \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629<br>\u0627\u0644\u0645\u0636\u0627\u0641\u0629</span><br>\r\n                        <span>VAT Amount</span>\r\n                    </td>\r\n                    <td class=\"bold bg-gray\" style=\"font-size: 12px;\">\r\n                        <span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u063a\u064a\u0631 \u0634\u0627\u0645\u0644 \u0636\u0631\u064a\u0628\u0629<br>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</span><br>\r\n                        <span>Subtotal Exclusive of VAT</span>\r\n                    </td>\r\n                    <td class=\"bold bg-gray\" style=\"font-size: 12px;\">\r\n                        <span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0634\u0627\u0645\u0644 \u0636\u0631\u064a\u0628\u0629<br>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</span><br>\r\n                        <span>Subtotal Inclusive of VAT</span>\r\n                    </td>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n               {% set total = namespace(amount = 0) %}\r\n               {%- for item in doc.items -%}\r\n                    {% set item_doc = frappe.get_doc('Item', item.item_code ) %}\r\n                    <tr class=\"text-center\" style=\"outline: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                        <td class=\"bold\" style=\"font-size: 12px;\">\r\n                            {% if(item_doc.custom_item_name_in_arabic) %}\r\n                                <span>{{ item_doc.custom_item_name_in_arabic or \"\" }}</span> <br>\r\n                            {% endif %}\r\n                            <span>{{ item_doc.item_name }}</span>\r\n                        </td>\r\n                        <td class=\"bold\" style=\"font-size: 12px;\">{{ item.qty }}</td>\r\n                        <td class=\"bold\" style=\"font-size: 12px;\">{{ \"{:,.2f}\".format(item.rate) }} {{ doc.currency }}</td>\r\n                        <td class=\"bold\" style=\"font-size: 12px;\">\r\n                            {{ \"%.1f\" % (item.tax_rate or 0) }} %\r\n                        </td>\r\n                        <td class=\"bold\" style=\"font-size: 12px;\">\r\n                                {{ \"{:,.2f}\".format(item.tax_amount or 0) }} {{ doc.currency }}\r\n                        </td>\r\n                        <td class=\"bold\" style=\"font-size: 12px;\">{{ \"{:,.2f}\".format(item.amount) }} {{ doc.currency }}</td>\r\n                        <td class=\"bold\" style=\"font-size: 12px;\">{{ \"{:,.2f}\".format(item.total_amount) }} {{ doc.currency }}</td>\r\n                    </tr>\r\n               {% endfor %}\r\n            </tbody>\r\n        </table>\r\n        <table class=\"total_table mb-3\">\r\n            <tbody>\r\n                {%- if(doc.discount_amount)-%}\r\n                    <tr style=\"outline: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                        <td class=\"bold bg-gray text-center smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);\">\r\n                            <span>\u062e\u0635\u0645 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span> <br>\r\n                            <span>Discount at Document Level</span>\r\n                        </td>\r\n                        <td class=\"bold bg-gray text-center smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);\">{{ \"{:,.2f}\".format(doc.discount_amount) }} {{ doc.currency }}</td>\r\n                    </tr>\r\n                {%- endif -%}\r\n\r\n                <tr style=\"outline: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                    <td class=\"bold bg-gray text-center smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);\">\r\n                        <span>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u064a\u0628\u0629 (\u063a\u064a\u0631 \u0634\u0627\u0645\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629)</span> <br>\r\n                        <span>Invoice Taxable Amount</span>\r\n                    </td>\r\n                    <td class=\"bold bg-gray text-center smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);\">{{ \"{:,.2f}\".format(doc.net_total) }} {{ doc.currency }}</td>\r\n                </tr>\r\n                <tr style=\"outline: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                    <td class=\"bold bg-gray text-center smaller_text\" style=\" borde