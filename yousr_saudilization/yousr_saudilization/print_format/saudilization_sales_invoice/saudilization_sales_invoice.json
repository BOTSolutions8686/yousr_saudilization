 "css": "@media print {\n    .overall_border {\n        transform: scale(0.96);\n        width: 100%;\n        border: 0.7px solid black;\n        border-radius: 5px;\n    }\n    \n    .col-md-12 col-sm-12{\n        margin-top:0px !important;\n    }\n}\n\nbody {\n    transform: scale(1.0);\n}\n\n\n.overall_border {\n    border: 0.7px solid black;\n    border-radius: 5px;\n}\n\n.title_p {\n    font-size: large;\n    font-weight: bold;\n}\n.text-center {\n    text-align: center;\n}\n\n.bold {\n    font-weight: bold;\n}\n\n.qr_table {\n    width:100%;\n    background-color: #ededed;\n    border-radius: 8px;\n}\n\n.seller_table {\n  width: 100%;\n  border: 1px solid rgba(0, 0, 0, 0.5); /* Light black border */\n  border-radius: 8px;\n  border-spacing: 0px;\n  border-collapse: separate;\n  padding: 10px;\n}\n\n\n.item_table {\n  width: 100%;\n  border: 1px solid rgba(0, 0, 0, 0.5); /* Light black border */\n  border-radius: 8px;\n  border-collapse: separate;\n\n}\n\n\n.total_table {\n  width: 75%;\n  border-collapse: collapse;\n}\n\n\n\n.span_heigt {\n    line-height:23px;\n}\n\n.bg-gray {\n    background-color: #f7f7f7;\n}\n\n.small_text {\n    font-size: small;\n}\n.smaller_text {\n    font-size: smaller;\n}\n\n\n\n/* Scoped native-template print tuning: readable A4, stable bilingual columns. */\n.print-format {font-family:Arial,sans-serif!important;font-size:10px!important;line-height:1.3!important;padding:8mm!important;}\n.print-format .overall_border {transform:none!important;border:0!important;}\n.print-format .col-md-12 {padding:0!important;}\n.print-format table {table-layout:fixed!important;width:100%!important;page-break-inside:avoid;}\n.print-format td,.print-format th {padding:4px!important;vertical-align:top!important;word-break:normal;overflow-wrap:break-word;}\n.print-format .seller_table {padding:5px!important;margin-bottom:8px!important;}\n.print-format .seller_table colgroup col {width:20%!important;}\n.print-format .seller_table .title_p {font-size:12px!important;margin:0 0 3px!important;}\n.print-format .title_p {font-size:16px!important;margin:0 0 8px!important;}\n.print-format .small_text,.print-format .smaller_text {font-size:10px!important;}\n.print-format .qr_table img {width:105px!important;height:105px!important;}\n.print-format .qr_table td {font-size:10px!important;}\n.print-format .span_heigt {line-height:17px!important;}\n.print-format .item_table {font-size:9px!important;}\n.print-format .item_table td {font-size:9px!important;}\n.print-format .item_table th {font-size:9px!important;}\n.print-format .item_table td:nth-child(1) {width:32%!important;}\n.print-format .total_table {width:75%!important;margin-left:auto;}\n.print-format .mt-5 {margin-top:10px!important;}\n",
 "custom_format": 1,
 "default_print_language": "en",
