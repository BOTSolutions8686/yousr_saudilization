 "creation": "2026-07-20 13:04:37.175697",
 "css": "@media print {\n    .overall_border {\n        transform: scale(0.96);\n        width: 100%;\n        border: 0.7px solid black;\n        border-radius: 5px;\n    }\n    \n    .col-md-12 col-sm-12{\n        margin-top:0px !important;\n    }\n}\n\nbody {\n    transform: scale(1.0);\n}\n\n\n.overall_border {\n    border: 0.7px solid black;\n    border-radius: 5px;\n}\n\n.title_p {\n    font-size: large;\n    font-weight: bold;\n}\n.text-center {\n    text-align: center;\n}\n\n.bold {\n    font-weight: bold;\n}\n\n.qr_table {\n    width:100%;\n    background-color: #ededed;\n    border-radius: 8px;\n}\n\n.seller_table {\n  width: 100%;\n  border: 1px solid rgba(0, 0, 0, 0.5); /* Light black border */\n  border-radius: 8px;\n  border-spacing: 0px;\n  border-collapse: separate;\n  padding: 10px;\n}\n\n\n.item_table {\n  width: 100%;\n  border: 1px solid rgba(0, 0, 0, 0.5); /* Light black border */\n  border-radius: 8px;\n  border-collapse: separate;\n\n}\n\n\n.total_table {\n  width: 75%;\n  border-collapse: collapse;\n}\n\n\n\n.span_heigt {\n    line-height:23px;\n}\n\n.bg-gray {\n    background-color: #f7f7f7;\n}\n\n.small_text {\n    font-size: small;\n}\n.smaller_text {\n    font-size: smaller;\n}\n\n\n",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set company = frappe.get_doc(\"Company\", doc.company)%}\r\n\r\n{% if (doc.company_address) %}\r\n    {% set company_address_doc = frappe.get_doc('Address', doc.company_address) %}\r\n{% endif %}\r\n\r\n\r\n{% if(doc.customer) %}\r\n    {% set customer = frappe.get_doc('Customer', doc.customer ) %}\r\n{% endif %}\r\n\r\n{% if(doc.customer_address) %}\r\n    {% set customer_address_doc = frappe.get_doc('Address', doc.customer_address ) %}\r\n{% endif %}\r\n\r\n\r\n    {% if letter_head and not no_letterhead -%}\r\n        {% if print_settings.repeat_header_footer %}\r\n            <div id=\"header-html\" class=\"hidden-pdf\">\r\n                <div class=\"letter-head\">\r\n                    {{ letter_head }}\r\n                </div>\r\n                <hr style=\"border: 1px solid lightgrey; margin: 5px 0;\">\r\n            </div>\r\n        {%- endif %}\r\n    {%- endif %}\r\n\r\n<div class=\"row overall_border\">\r\n    <div class=\"col-md-12 col-sm-12\">\r\n        <p class=\"text-center title_p\">\r\n          {% if doc.is_return %}\r\n            Credit Note \u0627\u0634\u0639\u0627\u0631 \u062f\u0627\u0626\u0646\r\n          {% else %}\r\n            Tax Invoice \u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629\r\n          {% endif %}\r\n        </p>\r\n        <table class=\"qr_table mb-2\">\r\n            <tbody>\r\n                <tr>\r\n                    <td class=\"bold \" style=\"font-size: small;\">\r\n                        <span class=\"span_heigt\">Invoice reference number(IRN)</span> <br>\r\n                        <span class=\"span_heigt\">{{ doc.name }}</span> <br>\r\n                        <span class=\"span_heigt\">Issue Date: {{ doc.posting_date }}</span><br>\r\n                        <strong style=\"font-weight: bold;\">Due Date:</strong> {{ frappe.utils.formatdate(doc.due_date, \"yyyy-mm-dd\") }}<br>\r\n            \r\n                        {% if doc.is_return and doc.return_against %}\r\n                        <span class=\"span_heigt\">Reference Inv No: {{ doc.return_against }}</span><br>\r\n                        {% endif %}  \r\n                    </td>\r\n                    <td class=\"text-center\" style=\"width: 180px;\">\r\n                        {% set details = get_phase_2_print_format_details(doc) %}\r\n                    \r\n                        {% if details and details.siaf and details.siaf.qr_image_src %}\r\n                            <img src=\"{{ details.siaf.qr_image_src }}\"\r\n                                 style=\"width:140px; height:140px;\">\r\n                        {% else %}\r\n                            <span style=\"font-size:10px; color:red;\">\r\n                                QR Code Not Available\r\n                            </span>\r\n                        {% endif %}\r\n                    </td>\r\n                                \r\n                    <td class=\"text-right bold\" style=\"font-size: small;\">\r\n                        <span class=\"span_heigt\">\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u0644\u0633\u0644\u064a</span> <br>\r\n                        <span class=\"span_heigt\">{{ doc.name }}</span> <br>\r\n                        <span class=\"span_heigt\">\u062a\u0627\u0631\u064a\u062e \u0627\u0635\u062f\u0627\u0631 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629: {{ doc.posting_date }}</span><br>\r\n                        <span class=\"span_heigt\"><strong>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642:</strong> {{ frappe.utils.formatdate(doc.due_date, \"yyyy-mm-dd\") }}</span><br>\r\n                        {% if doc.custom_delivery_date %}\r\n                        <span class=\"span_heigt\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u0635\u064a\u0644: \r\n                                {{ frappe.utils.formatdate(doc.custom_delivery_date, \"yyyy-mm-dd\") }}\r\n                        </span><br>\r\n                        {% endif %}    \r\n                        {% if doc.is_return and doc.return_against %}\r\n                            <span class=\"span_heigt\">{{ doc.return_against }} :\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629</span><br>\r\n                        {% endif %}\r\n                    </td>\r\n                </tr>\r\n            </tbody>\r\n        </table> \r\n        \r\n<table class=\"seller_table mb-2\">\r\n            <colgroup>\r\n                <col style=\"width: 24%;\">\r\n                <col style=\"width: 24%;\">\r\n                <col style=\"width: 4%;\">\r\n                <col style=\"width: 24%;\">\r\n                <col style=\"width: 24%;\">\r\n            </colgroup>\r\n            <tbody>\r\n                <tr>\r\n                    <td colspan=\"3\">\r\n                        <span class=\"title_p mb-2\" style=\"display: block;\">Seller Identification</span>\r\n                        <span class=\"bold small_text\">Seller Name</span>\r\n                    </td>\r\n                    <td class=\"text-right\" colspan=\"2\">\r\n                        <span class=\"title_p mb-2\" style=\"display: block;\">\u0647\u0648\u064a\u0629 \u0627\u0644\u0645\u0648\u0631\u062f</span>\r\n                        <span class=\"bold small_text\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f</span>\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.name or \"\"}}</td>\r\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.custom_company_name_in_arabic or \"\" }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"3\">\r\n                        <span class=\"bold small_text\">VAT Registration Number</span>\r\n                    </td>\r\n                    <td class=\"text-right\" colspan=\"2\">\r\n                        <span class=\"bold small_text\">\u0631\u0642\u0645 \u062a\u0633\u062c\u064a\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</span>\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.tax_id or \"\"}}</td>\r\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ company.tax_id or \"\"}}</td>\r\n                </tr>\r\n                \r\n                {% set setting_id = frappe.db.get_value(\"ZATCA Business Settings\", {\"company\": doc.company}, \"name\") %}\r\n                {% set seller_commercial_reg_no = frappe.db.get_value(\"Additional Seller IDs\", {\"parent\" : setting_id, 'type_name': 'Commercial Registration Number'}, 'value') %}\r\n                {% if(seller_commercial_reg_no) %}\r\n                    <tr>\r\n                        <td>\r\n                            <span class=\"bold smaller_text\">Additional Seller ID Type</span>\r\n                        </td>\r\n                        <td class=\"text-right\">\r\n                            <span class=\"bold smaller_text\">\u0646\u0648\u0639 \u0627\u0644\u0645\u0639\u0631\u0641\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629 \u0644\u0644\u0645\u0648\u0631\u062f</span>\r\n                        </td>\r\n                        <td></td>\r\n                        <td>\r\n                            <span class=\"bold smaller_text\">Additional Seller ID Number</span>\r\n                        </td>\r\n                        <td class=\"text-right\">\r\n                            <span class=\"bold smaller_text\">\u0631\u0642\u0645 \u0627\u0644\u0645\u0639\u0631\u0641\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629 \u0644\u0644\u0645\u0648\u0631\u062f</span>\r\n                        </td>\r\n                    </tr>\r\n                     {% if(seller_commercial_reg_no) %}\r\n                    <tr>\r\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">Commercial Registration (CR)</td>\r\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a</td>\r\n                        <td></td>\r\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ seller_commercial_reg_no or \"\"}}</td>\r\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ seller_commercial_reg_no or \"\"}}</td>\r\n                    </tr>\r\n                    {% endif %}\r\n                {% endif %}\r\n                {% if(company_address_doc) %}\r\n                    <tr>\r\n                        <td colspan=\"3\">\r\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">Address</span>\r\n                            <span class=\"bold small_text\">Street Name</span>\r\n                        </td>\r\n                        <td class=\"text-right\" colspan=\"2\">\r\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">\u0644\u0639\u0646\u0648\u0627\u0646</span>\r\n                            <span class=\"bold small_text\">\u0627\u0633\u0645 \u0627\u0644\u0634\u0627\u0631\u0639</span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                            {{ company_address_doc.address_line1}}\r\n                        </td>\r\n                        <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                            {{ company_address_doc.custom_address_line_1_in_arabic or \"\" }}\r\n                        </td>\r\n                    </tr>\r\n                    \r\n                    <tr>\r\n                        <td>\r\n                            <span class=\"bold smaller_text\">City</span>\r\n                        </td>\r\n                        <td class=\"text-right\">\r\n                            <span class=\"bold smaller_text\">\u0627\u0633\u0645 \u0627\u0644\u0645\u062f\u064a\u0646\u0629</span>\r\n                        </td>\r\n                        <td></td>\r\n                        {% if(company_address_doc.custom_building_number) %}\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">Building Number</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0631\u0642\u0645 \u0627\u0644\u0645\u0628\u0646\u0649</span>\r\n                            </td>\r\n                        {% else %}\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">Country Code</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0631\u0645\u0632 \u0627\u0644\u062f\u0648\u0644\u0629</span>\r\n                            </td>\r\n                        {% endif %}\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 5px;\">\r\n                             {{ company_address_doc.city or \"\" }}\r\n                        </td>\r\n                        \r\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 5px;\">\r\n                            {{ company_address_doc.custom_city_in_arabic or \"\" }}\r\n                        </td>\r\n                        <td></td>\r\n                        {% if(company_address_doc.custom_building_number) %}\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ company_address_doc.custom_building_number or \"\"}}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ company_address_doc.custom_building_number or \"\"}}\r\n                            </td>\r\n                        {% else %}\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ company_address_doc.custom_country_code or \"\" }}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ company_address_doc.custom_country_code or \"\" }}\r\n                            </td>\r\n                        {% endif %}\r\n    \r\n                    </tr>\r\n                    <tr>\r\n                        {% if(company_address_doc.custom_area) %}\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">District</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0627\u0633\u0645 \u0627\u0644\u062d\u064a</span>\r\n                            </td>\r\n                            <td></td>\r\n                        {% endif %}\r\n                        {% if(company_address_doc.custom_building_number) %}\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">Country Code</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0631\u0645\u0632 \u0627\u0644\u062f\u0648\u0644\u0629</span>\r\n                            </td>\r\n                        {% else %}\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">Postal Code</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0628\u0631\u064a\u062f\u0649</span>\r\n                            </td>\r\n                        {% endif %}\r\n                        {% if(not company_address_doc.custom_area and company_address_doc.custom_building_number) %}\r\n                            <td></td>\r\n                            <td>\r\n                                <span class=\"bold smaller_text\">Postal Code</span>\r\n                            </td>\r\n                            <td class=\"text-right\">\r\n                                <span class=\"bold smaller_text\">\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0628\u0631\u064a\u062f\u0649</span>\r\n                            </td>\r\n                        {% endif %}\r\n                    </tr>\r\n                    <tr>\r\n                        {% if(company_address_doc.custom_area) %}\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ company_address_doc.custom_area or \"\" }}\r\n                            </td>\r\n                            \r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                               {{ company_address_doc.custom_district_in_arabic or \"\" }}\r\n                            </td>\r\n                            <td></td>\r\n                        {% endif %}\r\n                        {% if(company_address_doc.custom_building_number) %}\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                             {% set country_doc = frappe.get_doc(\"Country\", company_address_doc.country) %}\r\n                                    {{ country_doc.code or \"\" }}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {% set country_doc = frappe.get_doc(\"Country\", company_address_doc.country) %}\r\n                                    {{ country_doc.code or \"\" }}\r\n                            </td>\r\n                        {% else %}\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                               {{ company_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ company_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                        {% endif %}\r\n                        {% if(not company_address_doc.custom_area and company_address_doc.custom_building_number) %}\r\n                            <td></td>\r\n                            <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                               {{ company_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                            <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                                {{ company_address_doc.pincode or \"\" }}\r\n                            </td>\r\n                        {% endif %}\r\n                    </tr>\r\n                    {% if(company_address_doc.pincode and company_address_doc.custom_building_number and company_address_doc.custom_area) %}\r\n                    <tr>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td>\r\n                            <span class=\"bold smaller_text\">Postal Code</span>\r\n                        </td>\r\n                        <td class=\"text-right\">\r\n                            <span class=\"bold smaller_text\">\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0628\u0631\u064a\u062f\u0649</span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td class=\"bold bg-gray smaller_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                            {{ company_address_doc.pincode or \"\" }}\r\n                        </td>\r\n                        <td class=\"bold bg-gray text-right smaller_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                            {{ company_address_doc.pincode or \"\" }}\r\n                        </td>\r\n                    </tr>\r\n                    {% endif %}\r\n                {% endif %}\r\n            </tbody>\r\n        </table>\r\n        <table class=\"seller_table mb-2\">\r\n            <colgroup>\r\n                <col style=\"width: 24%;\">\r\n                <col style=\"width: 24%;\">\r\n                <col style=\"width: 4%;\">\r\n                <col style=\"width: 24%;\">\r\n                <col style=\"width: 24%;\">\r\n            </colgroup>\r\n            <tbody>\r\n                <tr>\r\n                    <td colspan=\"3\">\r\n                        <span class=\"title_p mb-2\" style=\"display: block;\">Buyer Identification</span>\r\n                        <span class=\"bold small_text\">Buyer Name</span>\r\n                    </td>\r\n                    <td class=\"text-right\" colspan=\"2\">\r\n                        <span class=\"title_p mb-2\" style=\"display: block;\">\u062a\u062d\u062f\u064a\u062f \u0647\u0648\u064a\u0629 \u0627\u0644\u0639\u0645\u064a\u0644</span>\r\n                        <span class=\"bold small_text\">\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644</span>\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ customer.customer_name or \"\"}}</td>\r\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{customer.custom_customer_name_in_arabic or\"\"}}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"3\">\r\n                        <span class=\"bold small_text\">VAT Registration Number</span>\r\n                    </td>\r\n                    <td class=\"text-right\" colspan=\"2\">\r\n                        <span class=\"bold small_text\">\u0631\u0642\u0645 \u062a\u0633\u062c\u064a\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</span>\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ customer.custom_vat_registration_number or \"\" }}</td>\r\n                    <td colspan=\"2\" class=\"bold bg-gray text-right small_text\" style=\" border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">{{ customer.custom_vat_registration_number or \"\" }}</td>\r\n                </tr>\r\n                {% if(customer_address_doc) %}\r\n                    <tr>\r\n                        <td colspan=\"3\">\r\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">Buyer Address</span>\r\n                            <span class=\"bold small_text\">Street Name</span>\r\n                        </td>\r\n                        <td class=\"text-right\" colspan=\"2\">\r\n                            <span class=\"mb-2 bold\" style=\"display: block;font-size:15px;\">\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0639\u0645\u064a\u0644</span>\r\n                            <span class=\"bold small_text\">\u0627\u0633\u0645 \u0627\u0644\u0634\u0627\u0631\u0639</span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td colspan=\"3\" class=\"bold bg-gray small_text\" style=\"border: 1px solid rgba(0, 0, 0, 0.2);border-radius: 5px;\">\r\n                           {{ customer_address_doc.address_line1 }}\r\n                        </td>\r\n                        <td